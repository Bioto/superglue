# Copied to ~/.superglue/server.env on the server (mode 600).
# Provider keys are loaded from the process environment by the gateway.

GATEWAY_MASTER_KEY=

# At least one provider key required for completions
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# RUNINFRA_GATEWAY_KEY=
# TYPESAFE_API_KEY=

# Optional
# OPENAI_BASE_URL=
# RUST_LOG=info

# LLM traffic capture (requires gateway built with `capture` feature).
# Requests/responses are spooled locally and uploaded to S3 as gzip NDJSON.
SUPERGLUE_CAPTURE_S3_BUCKET=superglue-gateway-capture
SUPERGLUE_CAPTURE_S3_PREFIX=gateway-capture
# SUPERGLUE_CAPTURE_SPOOL_DIR=/home/ubuntu/superglue/capture-spool
# SUPERGLUE_CAPTURE_ROTATE_BYTES=67108864
# SUPERGLUE_CAPTURE_ROTATE_SECS=300
# SUPERGLUE_CAPTURE_MAX_RESPONSE_BYTES=16777216
# SUPERGLUE_CAPTURE_EXCLUDE_USERS=
AWS_REGION=us-west-2
